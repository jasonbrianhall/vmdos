!SWITCHES=/N
MENU 1 = FreeDOS on vmdos
MENU 2 = FreeDOS in VMHV's virtual machine (HIMEMX + JEMM386)
MENU 3 = FreeDOS in the virtual machine for Windows 3.x (HIMEMX only)
MENUDEFAULT = 1, 5
1?DEVICE=C:\VMDOS\VMXMS.SYS
1?DEVICE=C:\VMDOS\VMEMS.SYS
23?DEVICE=C:\VMDOS\HIMEMX.EXE
2?DEVICE=C:\VMDOS\JEMM386.EXE
DOS=HIGH,UMB
123?DEVICE=C:\VMDOS\VMCD.SYS
1?DEVICE=C:\VMDOS\VMHD.SYS
LASTDRIVE=Z
FILES=40
BUFFERS=20
SHELL=C:\COMMAND.COM C:\ /E:1024 /P=C:\AUTOEXEC.BAT
