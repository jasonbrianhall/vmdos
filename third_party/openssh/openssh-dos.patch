+static const LineInfo *
+el_line(EditLine *el)
+{
+	el->buf[*el->len] = '\0';
+	el->li.buffer = el->buf;
+	el->li.cursor = el->buf + *el->cur;
+	el->li.lastchar = el->buf + *el->len;
+	return &el->li;
+}
+
+/* Inserted at the cursor; one that doesn't fit is left out (not an error). */
+static int
+el_insertstr(EditLine *el, const char *str)
+{
+	int n = (int)strlen(str);
+
+	if (*el->len + n > el->max)
+		return 0;
+	memmove(el->buf + *el->cur + n, el->buf + *el->cur,
+	    *el->len - *el->cur);
+	memcpy(el->buf + *el->cur, str, n);
+	*el->len += n;
+	*el->cur += n;
+	el->buf[*el->len] = '\0';
+	return 0;
+}
+
+static int
+el_get(EditLine *el, int op, void **p)
+{
+	(void)op;
+	*p = el->data;
+	return 0;
+}
