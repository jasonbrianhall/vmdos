+#ifdef __DJGPP__
+/*
+ * DOS has no fork(): COMMAND.COM (%COMSPEC%) runs the command, sftp
+ * waiting meanwhile (spawn, system), as DOS runs a program from another.
+ * The ssh inside (dos-co.c) doesn't run until it's back: keep it short.
+ */
+#include <process.h>
+static void
+local_do_shell(const char *args)
+{
+	const char *shell;
+	int status;
+
+	if ((shell = getenv("COMSPEC")) == NULL || *shell == '\0')
+		shell = "COMMAND.COM";
+	fflush(stdout);
+	if (args == NULL || *args == '\0') {
+		printf("Type EXIT to return to sftp.\n");
+		fflush(stdout);
+		status = spawnlp(P_WAIT, shell, shell, (char *)NULL);
+	} else {
+		debug3("Executing %s /C \"%s\"", shell, args);
+		status = spawnlp(P_WAIT, shell, shell, "/C", args, (char *)NULL);
+	}
+	if (status == -1)
+		error("Couldn't execute \"%s\": %s", shell, strerror(errno));
+	else if (status != 0)
+		debug("Shell exited with status %d", status);
+}
+
+/* lls: DOS's DIR, with / in the arguments made \ (DIR's switches are /X) */
+static void
+local_do_ls(const char *args)
+{
+	char *buf, *p;
+	int quoted = 0;
+
+	if (args == NULL || *args == '\0') {
+		local_do_shell("DIR");
+		return;
+	}
+	xasprintf(&buf, "DIR %s", args);
+	for (p = buf + 4; *p; p++) {
+		if (*p == '"')
+			quoted = !quoted;
+		else if (*p == '/' && (quoted || (p > buf + 4 && p[-1] != ' ')))
+			*p = '\\';	/* a path's /, not a /W switch */
+	}
+	local_do_shell(buf);
+	free(buf);
+}
