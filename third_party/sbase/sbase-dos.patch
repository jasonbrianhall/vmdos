+#ifdef __DJGPP__
+/* DOS runs one program at a time: bc's dc program goes to a temporary
+   file, and dc runs on it when bc is done. */
+static char dctmp[FILENAME_MAX];
+static int dcout = -1;
+
+static void
+rundc(void)
+{
+	int fd;
+	fflush(stdout);
+	dup2(dcout, 1);
+	close(dcout);
+	if ((fd = open(dctmp, O_RDONLY)) >= 0) {
+		if (fd != 0) {	/* bc may have closed its stdin by now */
+			dup2(fd, 0);
+			close(fd);
+		}
+		if (spawnlp(P_WAIT, dcprog, "dc", sflag ? "-i" : NULL, (char *)NULL) == -1)
+			weprintf("dc:");
+	}
+	remove(dctmp);
+}
+
+static void
+spawn(void)
+{
+	const char *t = getenv("TMP");
+	int fd;
+	snprintf(dctmp, sizeof(dctmp), "%s/bcXXXXXX", t && *t ? t : ".");
+	if ((fd = mkstemp(dctmp)) < 0)
+		eprintf("mkstemp %s:", dctmp);
+	dcout = dup(1);
+	dup2(fd, 1);
+	close(fd);
+	atexit(rundc);
+}
+#else
 static void
