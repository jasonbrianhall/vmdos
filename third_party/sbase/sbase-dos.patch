+#ifdef __DJGPP__
+/* On the screen, names go in columns (as GNU's and BSD's ls do): the
+   output goes to a temporary file, and at the end it is laid out for the
+   screen's width (the BIOS's). -1 and -l keep one per line. */
+#include <sys/farptr.h>
+#include <go32.h>
+
+static int dos_one, dos_cols, dos_tty = -1;
+static FILE *dos_tmp;
+
+static void
+dos_columns_begin(void)
+{
+	fflush(stdout);
+	if (!(dos_tmp = tmpfile()) || (dos_tty = dup(1)) < 0)
+		return;
+	dup2(fileno(dos_tmp), 1);
+	dos_cols = 1;
+}
+
+static void
+dos_block(char **l, size_t n, size_t width)
+{
+	size_t i, r, c, w = 0, ncols, rows;
+
+	for (i = 0; i < n; i++)
+		if (strlen(l[i]) > w)
+			w = strlen(l[i]);
+	ncols = (width + 2) / (w + 2);
+	if (ncols < 1)
+		ncols = 1;
+	rows = (n + ncols - 1) / ncols;
+	for (r = 0; r < rows; r++) {
+		for (c = 0; c < ncols; c++) {
+			i = c * rows + r;
+			if (i >= n)
+				break;
+			if (c + 1 < ncols && i + rows < n)
+				printf("%-*s", (int)(w + 2), l[i]);
+			else
+				fputs(l[i], stdout);
+		}
+		putchar('\n');
+	}
+}
+
+static void
+dos_columns_end(void)
+{
+	char *line = NULL, **l = NULL;
+	size_t size = 0, n = 0, i, width;
+	ssize_t len;
+
+	fflush(stdout);
+	dup2(dos_tty, 1);
+	close(dos_tty);
+	rewind(dos_tmp);
+	width = _farpeekw(_dos_ds, 0x44A);
+	if (width < 20 || width > 400)
+		width = 80;
+	while ((len = getline(&line, &size, dos_tmp)) > 0) {
+		if (line[len - 1] == '\n')
+			line[--len] = '\0';
+		if (len == 0 || line[len - 1] == ':') {
+			/* a blank line, or `dir:' when there are several */
+			dos_block(l, n, width);
+			for (i = 0; i < n; i++)
+				free(l[i]);
+			n = 0;
+			puts(line);
+			continue;
+		}
+		l = ereallocarray(l, n + 1, sizeof(*l));
+		l[n++] = estrdup(line);
+	}
+	dos_block(l, n, width);
+	for (i = 0; i < n; i++)
+		free(l[i]);
+	free(l);
+	free(line);
+	fclose(dos_tmp);
+}
+#endif
