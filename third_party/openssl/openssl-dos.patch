diff --git a/apps/openssl.c b/apps/openssl.c
index cd015e2..00460c1 100644
--- a/apps/openssl.c
+++ b/apps/openssl.c
@@ -10,6 +10,7 @@
 #include "internal/e_os.h"
 
 #include <stdio.h>
+#include <ctype.h>
 #include <stdlib.h>
 #include "internal/common.h"
 #include <openssl/bio.h>
@@ -268,6 +269,17 @@ int main(int argc, char *argv[])
     win32_utf8argv(&argc, &argv);
 #endif
 
+#ifdef __DJGPP__
+    /* DOS: OPENSSL VERSION as well as openssl version (the command names
+       are all lower case) */
+    if (argc > 1) {
+        char *c;
+
+        for (c = argv[1]; *c != '\0'; c++)
+            *c = (char)tolower((unsigned char)*c);
+    }
+#endif
+
 #ifndef OPENSSL_NO_TRACE
     setup_trace(getenv("OPENSSL_TRACE"));
 #endif
diff --git a/crypto/bio/bio_sock.c b/crypto/bio/bio_sock.c
